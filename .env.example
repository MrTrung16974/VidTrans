# TikTok Developer App with Login Kit + Content Posting API (Direct Post)
VIDTRANS_TIKTOK_CLIENT_KEY=
VIDTRANS_TIKTOK_CLIENT_SECRET=
# This exact HTTPS URL must also be registered in the TikTok Developer portal.
VIDTRANS_TIKTOK_REDIRECT_URI=https://your-domain.example/api/v1/tiktok-auth/callback
VIDTRANS_TIKTOK_SCOPES=video.publish

# Instagram API with Instagram Login + Content Publishing.
VIDTRANS_INSTAGRAM_CLIENT_ID=
VIDTRANS_INSTAGRAM_CLIENT_SECRET=
VIDTRANS_INSTAGRAM_REDIRECT_URI=https://your-domain.example/api/v1/instagram-auth/callback
VIDTRANS_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
VIDTRANS_INSTAGRAM_API_VERSION=v24.0

# Facebook Login + Graph API. These identify the VidTrans system app;
# end users connect their own Pages from the web UI and never edit this file.
VIDTRANS_FACEBOOK_CLIENT_ID=
VIDTRANS_FACEBOOK_CLIENT_SECRET=
VIDTRANS_FACEBOOK_REDIRECT_URI=https://your-domain.example/api/v1/facebook-auth/callback
VIDTRANS_FACEBOOK_API_BASE=https://graph.facebook.com/v24.0

# Google OAuth + YouTube Data API. These identify the VidTrans system app;
# end users connect their own channels from the web UI and never edit this file.
VIDTRANS_YOUTUBE_CLIENT_ID=
VIDTRANS_YOUTUBE_CLIENT_SECRET=
VIDTRANS_YOUTUBE_REDIRECT_URI=https://your-domain.example/api/v1/youtube-auth/callback

# Public HTTPS origin used by Meta to fetch a rendered Reel.
VIDTRANS_PUBLIC_BASE_URL=https://your-domain.example
# Generate a random value of at least 32 characters and keep it secret.
VIDTRANS_MEDIA_SIGNING_SECRET=

# Threads API
VIDTRANS_THREADS_CLIENT_ID=
VIDTRANS_THREADS_CLIENT_SECRET=
VIDTRANS_THREADS_REDIRECT_URI=https://your-domain.example/api/v1/threads-auth/callback
VIDTRANS_THREADS_SCOPES=threads_basic,threads_content_publish

# Pinterest API v5 (pins:read,pins:write,boards:read)
VIDTRANS_PINTEREST_ACCESS_TOKEN=
VIDTRANS_PINTEREST_BOARD_ID=

# LinkedIn Community Management API (w_member_social or w_organization_social)
VIDTRANS_LINKEDIN_ACCESS_TOKEN=
VIDTRANS_LINKEDIN_OWNER_URN=
VIDTRANS_LINKEDIN_API_VERSION=202609

# Authenticated encryption for per-user social access/refresh tokens in SQLite.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIDTRANS_CREDENTIAL_ENCRYPTION_KEY=
VIDTRANS_CREDENTIAL_ENCRYPTION_KEY_ID=primary

# OAuth2 Password + JWT for the VidTrans admin UI and API.
# Generate both secrets with: docker compose run --rm vidtrans python -m infrastructure.auth
VIDTRANS_AUTH_ENABLED=0
VIDTRANS_AUTH_USERNAME=admin
VIDTRANS_AUTH_PASSWORD_HASH=
VIDTRANS_JWT_SECRET=
VIDTRANS_JWT_ISSUER=vidtrans
VIDTRANS_JWT_AUDIENCE=vidtrans-api
VIDTRANS_JWT_TTL_MINUTES=480
VIDTRANS_AUTH_COOKIE_NAME=vidtrans_access_token
# Set to 1 when VidTrans is served through HTTPS.
VIDTRANS_AUTH_COOKIE_SECURE=0
# Keep 0 locally. docker-compose.production.yml enables trusted Nginx client IP headers.
VIDTRANS_TRUST_PROXY_HEADERS=0

# Cookie YouTube/Facebook cho yt-dlp (Netscape format). Khi chạy Docker, lưu file tại
# ./secrets/yt-dlp-cookies.txt; không commit file này vì nó chứa phiên đăng nhập.
# VIDTRANS_YTDLP_COOKIE_FILE=/app/secrets/yt-dlp-cookies.txt
VIDTRANS_YTDLP_COOKIE_FILE=

# Generated automatically by: bash docker-rebuild.sh --production
# VIDTRANS_PUBLIC_HOST=video.example.com
# VIDTRANS_LETSENCRYPT_EMAIL=admin@example.com

# ──────────────────────────────────────────────────────────────────────────────
# Proxy cho trình duyệt (tùy chọn)
# ──────────────────────────────────────────────────────────────────────────────
# Nếu VPS IP bị TikTok / Douyin chặn đăng nhập QR, hãy dùng proxy residential
# hoặc SOCKS5 để đổi IP cho Chromium.
#
# Định dạng hỗ trợ:
#   socks5://user:password@host:port   (khuyên dùng — ẩn IP tốt nhất)
#   http://host:port
#   http://user:password@host:port
#   socks4://host:port
#
# Ví dụ:
#   VIDTRANS_TIKTOK_PROXY=socks5://myuser:mypass@proxy.example.com:1080
#   VIDTRANS_DOUYIN_PROXY=http://proxy.example.com:8080
#
# Để trống = kết nối trực tiếp từ VPS (mặc định).
VIDTRANS_TIKTOK_PROXY=
VIDTRANS_DOUYIN_PROXY=
VIDTRANS_SOCIAL_BROWSER_PROXY=

# Tùy chọn override proxy chỉ cho yt-dlp YouTube. Để trống thì hệ thống tự dùng
# VIDTRANS_SOCIAL_BROWSER_PROXY, nhờ đó Chromium đăng nhập và yt-dlp tải video
# qua đúng một IP thoát. Chỉ cần đặt biến này khi thực sự muốn tách riêng route.
VIDTRANS_YOUTUBE_PROXY=

# Dịch tiếng Việt: để trống dùng kết nối trực tiếp, không dùng proxy trình duyệt.
# Chỉ hỗ trợ HTTP/HTTPS; không đặt SOCKS5 ở đây.
VIDTRANS_TRANSLATION_PROXY=

# Nhận diện giọng nói Trung.
# faster = faster-whisper (int8, nhanh hơn nhiều trên CPU); openai = openai-whisper cũ.
VIDTRANS_ASR_ENGINE=faster
# int8 nhanh nhất trên CPU; float32 chính xác hơn một chút nhưng chậm hơn.
VIDTRANS_ASR_COMPUTE_TYPE=int8
# 5 = chính xác (mặc định); 1-2 = nhanh hơn ~1.5-2 lần.
VIDTRANS_ASR_BEAM_SIZE=5
# 1 = bỏ qua đoạn nhạc/im lặng bằng VAD trước khi nhận diện.
VIDTRANS_ASR_VAD=1
# 0 = dùng tất cả nhân CPU.
VIDTRANS_ASR_CPU_THREADS=0
