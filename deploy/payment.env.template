# Sao chép các tên biến này vào secret manager hoặc môi trường chạy ứng dụng.
# Không commit file chứa giá trị thật.
VIDTRANS_PAYMENT_ENABLED=true

# Chuyển khoản vào tài khoản MB cá nhân
VIDTRANS_BANK_NAME=MB Bank
VIDTRANS_BANK_BIN=<MB_BANK_BIN>
VIDTRANS_BANK_ACCOUNT_NO=<MB_ACCOUNT_NUMBER>
VIDTRANS_BANK_ACCOUNT_NAME=<MB_ACCOUNT_HOLDER_WITHOUT_ACCENTS>
VIDTRANS_BANK_QR_TEMPLATE=compact2

# Secret tối thiểu 32 ký tự cho dịch vụ đối soát gọi webhook ngân hàng.
# Header callback: X-VidTrans-Signature: sha256=<HMAC_SHA256_RAW_BODY>
VIDTRANS_BANK_WEBHOOK_SECRET=<GENERATE_A_RANDOM_SECRET_AT_DEPLOY_TIME>

# Chỉ cần khi bật ví điện tử
VIDTRANS_PUBLIC_BASE_URL=https://<YOUR_PUBLIC_DOMAIN>
VIDTRANS_MOMO_PARTNER_CODE=
VIDTRANS_MOMO_ACCESS_KEY=
VIDTRANS_MOMO_SECRET_KEY=
VIDTRANS_MOMO_ENDPOINT=
VIDTRANS_ZALOPAY_APP_ID=
VIDTRANS_ZALOPAY_KEY1=
VIDTRANS_ZALOPAY_KEY2=
VIDTRANS_ZALOPAY_ENDPOINT=
